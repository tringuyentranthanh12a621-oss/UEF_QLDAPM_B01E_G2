<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_bg">

    <LinearLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/dark_bg"
        app:layout_constraintTop_toTopOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingHorizontal="16dp">

            <ImageView
                android:id="@+id/btnBackDetail"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_launcher_foreground"
                android:rotation="180"
                android:layout_centerVertical="true"
                app:tint="@color/white"/>

            <TextView
                android:id="@+id/tvDetailTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Movie Title"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_centerInParent="true"/>
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <LinearLayout
                android:id="@+id/tabAbout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:id="@+id/tvTabAbout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="About"
                    android:textColor="@color/orange_main"
                    android:textStyle="bold"
                    android:padding="12dp"/>
                <View
                    android:id="@+id/viewTabAbout"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:background="@color/orange_main"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabSessions"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:id="@+id/tvTabSessions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sessions"
                    android:textColor="@color/text_grey"
                    android:padding="12dp"/>
                <View
                    android:id="@+id/viewTabSessions"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#25293E"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/headerContainer"
        app:layout_constraintBottom_toTopOf="@id/btnSelectSession">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/layoutAbout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="250dp">
                    <ImageView
                        android:id="@+id/imgDetailPoster"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/the_batman" />
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#40000000"/>
                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_splash_circle"
                        android:padding="15dp"
                        android:src="@android:drawable/ic_media_play"
                        app:tint="@color/white"/>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:background="#25293E"
                    android:baselineAligned="false">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/tvDetailRating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="8.3"
                            android:textColor="@color/white"
                            android:textSize="22sp"
                            android:textStyle="bold"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="IMDb"
                            android:textColor="@color/text_grey"
                            android:textSize="12sp"/>
                    </LinearLayout>
                    <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#3A3F58"/>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView
                            android:text="7.9"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/white"
                            android:textSize="22sp"
                            android:textStyle="bold"/>
                        <TextView
                            android:text="Kinopoisk"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_grey"
                            android:textSize="12sp"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:id="@+id/tvDetailDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Description..."
                        android:textColor="@color/white"
                        android:lineSpacingExtra="4dp"
                        android:textSize="14sp"/>

                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="2"
                        android:layout_marginTop="20dp">
                        <TextView android:text="Certificate" android:textColor="@color/text_grey" android:width="100dp" android:layout_marginBottom="12dp"/>
                        <TextView android:text="16+" android:textColor="@color/white" android:background="@drawable/bg_input_field" android:paddingHorizontal="8dp" android:paddingVertical="2dp"/>

                        <TextView android:text="Runtime" android:textColor="@color/text_grey" android:layout_marginBottom="12dp"/>
                        <TextView android:id="@+id/tvDetailDuration" android:text="02:56" android:textColor="@color/white"/>

                        <TextView android:text="Genre" android:textColor="@color/text_grey" android:layout_marginBottom="12dp"/>
                        <TextView android:id="@+id/tvDetailGenre" android:text="Action" android:textColor="@color/white"/>
                    </GridLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutSessions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:background="#1F2235">

                    <LinearLayout
                        android:id="@+id/btnDateFilter"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground"
                        android:layout_height="wrap_content">
                        <ImageView android:src="@android:drawable/ic_menu_my_calendar" app:tint="#8C8C8C" android:layout_width="20dp" android:layout_height="20dp"/>
                        <TextView android:id="@+id/tvDateFilter" android:text="April, 18" android:textColor="@color/white" android:textSize="12sp" android:layout_marginTop="4dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:layout_height="wrap_content">
                        <ImageView android:src="@android:drawable/ic_menu_sort_by_size" app:tint="#8C8C8C" android:layout_width="20dp" android:layout_height="20dp"/>
                        <TextView android:text="Time ↑" android:textColor="@color/white" android:textSize="12sp" android:layout_marginTop="4dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:layout_height="wrap_content">
                        <Switch android:layout_width="wrap_content" android:layout_height="20dp" android:checked="false"/>
                        <TextView android:text="By cinema" android:textColor="@color/white" android:textSize="12sp" android:layout_marginTop="4dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="#25293E"
                    android:paddingVertical="8dp">
                    <TextView android:text="Time" android:textColor="#5A6076" android:textSize="12sp" android:gravity="center" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="wrap_content"/>
                    <TextView android:text="Adult" android:textColor="#5A6076" android:textSize="12sp" android:gravity="center" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
                    <TextView android:text="Child" android:textColor="#5A6076" android:textSize="12sp" android:gravity="center" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
                    <TextView android:text="Student" android:textColor="#5A6076" android:textSize="12sp" android:gravity="center" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
                    <TextView android:text="VIP" android:textColor="#5A6076" android:textSize="12sp" android:gravity="center" android:layout_width="0dp" android:layout_weight="0.8" android:layout_height="wrap_content"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/itemSession1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="16dp"
                    android:gravity="center_vertical"
                    android:layout_marginTop="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/bg_session_item_selector">

                    <LinearLayout android:layout_width="0dp" android:layout_weight="1.2" android:orientation="vertical" android:gravity="center" android:layout_height="wrap_content">
                        <TextView android:text="14:40" android:textColor="@color/white" android:textSize="18sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:text="Pyc" android:textColor="#5A6076" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_weight="3.8" android:orientation="vertical" android:paddingStart="8dp" android:layout_height="wrap_content">
                        <TextView android:text="Eurasia Cinema7" android:textColor="@color/white" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
                            <TextView android:text="2200 ₸" android:textColor="#C0C0C0" android:textSize="13sp" android:layout_marginEnd="12dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                            <TextView android:text="1000 ₸" android:textColor="#C0C0C0" android:textSize="13sp" android:layout_marginEnd="12dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                            <TextView android:text="1500 ₸" android:textColor="#C0C0C0" android:textSize="13sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/itemSession2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="16dp"
                    android:gravity="center_vertical"
                    android:layout_marginTop="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/bg_session_item_selector">

                    <LinearLayout android:layout_width="0dp" android:layout_weight="1.2" android:orientation="vertical" android:gravity="center" android:layout_height="wrap_content">
                        <TextView android:text="15:10" android:textColor="@color/white" android:textSize="18sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:text="IMAX Pyc" android:textColor="#5A6076" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_weight="3.8" android:orientation="vertical" android:paddingStart="8dp" android:layout_height="wrap_content">
                        <TextView android:text="Kinopark 8 IMAX" android:textColor="@color/white" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
                            <TextView android:text="3500 ₸" android:textColor="#C0C0C0" android:textSize="13sp" android:layout_marginEnd="12dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                            <TextView android:text="1500 ₸" android:textColor="#C0C0C0" android:textSize="13sp" android:layout_marginEnd="12dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                            <TextView android:text="2500 ₸" android:textColor="#C0C0C0" android:textSize="13sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout> <View android:layout_width="match_parent" android:layout_height="80dp"/>

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnSelectSession"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_margin="16dp"
        android:text="Select session"
        android:textAllCaps="false"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:backgroundTint="@color/orange_main"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>