<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_launcher_foreground"
            android:rotation="180"/> <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Eurasia Cinema7"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="18sp"/>
        <TextView
            android:id="@+id/tvMovieTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="The Batman"
            android:textColor="@color/text_grey"
            android:textSize="14sp"/>
    </LinearLayout>
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginBottom="24dp"
        android:orientation="horizontal">

        <View
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="#25293E"
            android:backgroundTint="#3A3F58"/> <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=" Available"
        android:textColor="@color/text_grey"
        android:layout_marginEnd="16dp"/>

        <View
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="#25293E"
            android:backgroundTint="#505050"/> <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=" Occupied"
        android:textColor="@color/text_grey"
        android:layout_marginEnd="16dp"/>

        <View
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@color/orange_main"/> <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=" Chosen"
        android:textColor="@color/text_grey"/>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SCREEN"
        android:gravity="center"
        android:textColor="@color/text_grey"
        android:layout_marginBottom="10dp"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:background="@drawable/ic_launcher_background"
        android:backgroundTint="#3A3F58"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="20dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <GridLayout
            android:id="@+id/gridLayoutSeats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:columnCount="11"
            android:rowCount="8"
            android:useDefaultMargins="true">
        </GridLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnBuyTicket"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/orange_main"
        android:text="Buy tickets • 0 T"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:padding="14dp"/>
</LinearLayout>