<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_bg"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvTitleAddCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add card"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <EditText
        android:id="@+id/edtCardNumber"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="30dp"
        android:background="@drawable/bg_input_field"
        android:hint="Card number"
        android:textColorHint="@color/text_grey"
        android:textColor="@color/white"
        android:paddingHorizontal="16dp"
        android:inputType="number"
        app:layout_constraintTop_toBottomOf="@id/tvTitleAddCard"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/edtCardNumber">

        <EditText
            android:id="@+id/edtMM"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_input_field"
            android:hint="MM"
            android:gravity="center"
            android:textColorHint="@color/text_grey"
            android:textColor="@color/white"
            android:inputType="number"
            android:maxLength="2"/>

        <EditText
            android:id="@+id/edtYY"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_input_field"
            android:hint="YY"
            android:gravity="center"
            android:textColorHint="@color/text_grey"
            android:textColor="@color/white"
            android:inputType="number"
            android:maxLength="2"/>

        <EditText
            android:id="@+id/edtCVC"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input_field"
            android:hint="CVC"
            android:gravity="center"
            android:textColorHint="@color/text_grey"
            android:textColor="@color/white"
            android:inputType="number"
            android:maxLength="3"/>
    </LinearLayout>

    <Button
        android:id="@+id/btnConfirmAddCard"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginBottom="20dp"
        android:text="Add card"
        android:backgroundTint="@color/orange_main"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textAllCaps="false"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>