<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_bg"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvTitleCardDetail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bank card"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="4716 •••• •••• 5615"
        android:textColor="#5A6076"
        android:textSize="18sp"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitleCardDetail"/>

    <Button
        android:id="@+id/btnRemoveCard"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="40dp"
        android:text="Remove card"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textAllCaps="false"
        android:backgroundTint="#30354A"
        app:cornerRadius="12dp"
        app:strokeColor="#3A3F58"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitleCardDetail"/>

</androidx.constraintlayout.widget.ConstraintLayout>